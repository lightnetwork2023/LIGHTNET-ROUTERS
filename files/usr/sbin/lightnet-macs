#!/bin/sh
# Device identity = factory label MAC (DT label-mac-device -> gmac0, Factory NVMEM).
# Pinned once in /etc/lightnet/device.mac so the ID never changes across reboots,
# even if interface MACs are rewritten (wan/lan2 get a locally administered 02:… MAC).

what="$1"
pin=/etc/lightnet/device.mac

valid_mac() {
	case "$1" in
		??:??:??:??:??:??) ;;
		*) return 1 ;;
	esac
	case "$1" in
		00:00:00:00:00:00|ff:ff:ff:ff:ff:ff|FF:FF:FF:FF:FF:FF) return 1 ;;
	esac
	# reject locally administered addresses (bit 1 of the first octet)
	[ $(( 0x${1%%:*} & 2 )) -eq 0 ]
}

base="$(cat "$pin" 2>/dev/null | tr 'A-F' 'a-f')"
valid_mac "$base" || base=""

if [ -z "$base" ]; then
	. /lib/functions.sh
	. /lib/functions/system.sh
	base="$(get_mac_label 2>/dev/null | tr 'A-F' 'a-f')"
	valid_mac "$base" || base=""
fi

if [ -z "$base" ]; then
	for dev in eth0 lan1 wan; do
		[ -r "/sys/class/net/$dev/address" ] || continue
		candidate="$(cat "/sys/class/net/$dev/address" | tr 'A-F' 'a-f')"
		valid_mac "$candidate" && { base="$candidate"; break; }
	done
fi

[ -z "$base" ] && exit 1

[ -s "$pin" ] || { mkdir -p /etc/lightnet && printf '%s\n' "$base" > "$pin" 2>/dev/null; }

OIFS="$IFS"
IFS=':'
set -- $base
IFS="$OIFS"

[ $# -ne 6 ] && exit 1

case "$what" in
	id|base)
		printf '%s\n' "$base"
		exit 0 ;;
esac

last=$((0x$6))
case "$what" in
	wan|lan2)
		off=4 ;;
	mesh|mesh0)
		off=5 ;;
	bat0)
		off=6 ;;
	ap1|radio1)
		off=7 ;;
	*)
		exit 1 ;;
esac

printf '02:%s:%s:%s:%s:%02x\n' "$2" "$3" "$4" "$5" $(( (last + off) & 255 ))
