#!/bin/sh
# Status LED: red while the unit has no network, blue once it is connected.
#   root  (main)      blue = Internet reachable through the WAN/upstream
#   agent (satellite) blue = adopted and the controller answered the last inform (<60 s)
#   anything else     red (detecting, pending approval, mesh lost, no data)
# Called every 15 s by lightnet-agent-loop; `lightnet-led red|blue` forces a colour.
RED=/sys/class/leds/red:status
BLUE=/sys/class/leds/blue:status
STATE=/tmp/lightnet-led

set_led() { [ -d "$1" ] || return 0; echo none >"$1/trigger" 2>/dev/null; echo "$2" >"$1/brightness" 2>/dev/null; }
show() {
	[ "$(cat "$STATE" 2>/dev/null)" = "$1" ] && return 0
	if [ "$1" = blue ]; then set_led "$RED" 0; set_led "$BLUE" 1; else set_led "$BLUE" 0; set_led "$RED" 1; fi
	echo "$1" >"$STATE"
	logger -t lightnet-led "status $1"
}

online() {
	role="$(sed -n 's/^active_role=//p' /etc/lightnet/state 2>/dev/null | tail -n1)"
	case "$role" in
		root)
			ip -4 route show default 2>/dev/null | grep -q . || return 1
			ping -c 1 -W 2 1.1.1.1 >/dev/null 2>&1 || ping -c 1 -W 2 8.8.8.8 >/dev/null 2>&1 ;;
		agent)
			[ "$(uci -q get lightnet.main.adopted)" = "1" ] || return 1
			[ -f /tmp/lightnet-inform.ok ] || return 1
			[ $(( $(date +%s) - $(date -r /tmp/lightnet-inform.ok +%s 2>/dev/null || echo 0) )) -lt 60 ] ;;
		*) return 1 ;;
	esac
}

case "$1" in
	red|blue) show "$1" ;;
	*) online && show blue || show red ;;
esac
exit 0
