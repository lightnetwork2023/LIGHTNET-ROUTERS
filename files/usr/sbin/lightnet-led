#!/bin/sh
# Status LED. The JCG Q20 only has red + blue GPIOs (no green:status).
#   root  (main)      green if the LED exists, otherwise solid blue
#                     = Internet reachable through the WAN/upstream
#   agent (satellite) blinking blue = adopted and last inform answered <60 s
#   anything else     red (detecting, pending, mesh lost, no data)
# Called every 15 s by lightnet-agent-loop; `lightnet-led red|blue|green` forces a colour.
RED=/sys/class/leds/red:status
BLUE=/sys/class/leds/blue:status
GREEN=/sys/class/leds/green:status
STATE=/tmp/lightnet-led

set_led() { [ -d "$1" ] || return 0; echo none >"$1/trigger" 2>/dev/null; echo "$2" >"$1/brightness" 2>/dev/null; }

blink_blue() {
	set_led "$RED" 0
	set_led "$GREEN" 0
	[ -d "$BLUE" ] || return 0
	echo timer >"$BLUE/trigger" 2>/dev/null
	echo 400 >"$BLUE/delay_on" 2>/dev/null
	echo 1600 >"$BLUE/delay_off" 2>/dev/null
}

show() {
	[ "$(cat "$STATE" 2>/dev/null)" = "$1" ] && return 0
	case "$1" in
		green)
			if [ -d "$GREEN" ]; then
				set_led "$RED" 0
				set_led "$BLUE" 0
				set_led "$GREEN" 1
			else
				# Q20 hardware has no green LED: main stays solid blue.
				set_led "$RED" 0
				set_led "$GREEN" 0
				set_led "$BLUE" 1
			fi
			;;
		blue)
			blink_blue
			;;
		*)
			set_led "$BLUE" 0
			set_led "$GREEN" 0
			set_led "$RED" 1
			;;
	esac
	echo "$1" >"$STATE"
	logger -t lightnet-led "status $1"
}

online() {
	role="$(sed -n 's/^active_role=//p' /etc/lightnet/state 2>/dev/null | tail -n1)"
	case "$role" in
		root)
			ip -4 route show default 2>/dev/null | grep -q . || return 1
			ping -c 1 -W 2 1.1.1.1 >/dev/null 2>&1 || ping -c 1 -W 2 8.8.8.8 >/dev/null 2>&1 ;;
		agent)
			[ "$(uci -q get lightnet.main.adopted)" = "1" ] || return 1
			[ -f /tmp/lightnet-inform.ok ] || return 1
			[ $(( $(date +%s) - $(date -r /tmp/lightnet-inform.ok +%s 2>/dev/null || echo 0) )) -lt 60 ] ;;
		*) return 1 ;;
	esac
}

colour() {
	role="$(sed -n 's/^active_role=//p' /etc/lightnet/state 2>/dev/null | tail -n1)"
	online || { show red; return; }
	[ "$role" = "root" ] && show green || show blue
}

case "$1" in
	red|blue|green) show "$1" ;;
	*) colour ;;
esac
exit 0
