#!/bin/sh
# LightNet hotspot (CoovaChilli) on a dedicated VLAN carried over the mesh.
#   net on|off      create/remove bat0.10 + br-hotspot and move client SSIDs (any role)
#   start|stop      run/stop chilli from /etc/lightnet/server.json (root only)
#   status          JSON summary
#   authorize MAC   authorize a session without the portal (e.g. technician devices)

SERVER_JSON=/etc/lightnet/server.json
CONF=/var/run/lightnet-chilli.conf
PID=/var/run/lightnet-chilli.pid
SOCK=/var/run/lightnet-chilli.sock
HS_NET=192.168.88.0/24
HS_GW=192.168.88.1
VLAN=10
MGMT_GW=192.168.200.1
MGMT_PORTS="lan1"
PORTAL_SRC=/etc/lightnet/portal
WWWDIR=/var/run/lightnet-www

log() { logger -t lightnet-hotspot "$*"; }
jget() { jsonfilter -i "$SERVER_JSON" -e "$1" 2>/dev/null; }
jsq() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

# Router-hosted portal (MikroTik model): chilli UAM httpd serves a local page.
# The page does not need client-side DNS for packages because the router fetches
# the package list from the server and embeds it in config.js. Payment still
# calls the server API; if that fails, the user can use "Nina Code".
# Set `uci set lightnet.cloud.portal=server` to use the server /buy page directly.
portal_url() {
	buy="$(jget '@.portal.buy_url')"
	[ "$(uci -q get lightnet.cloud.portal)" != "server" ] || { printf '%s' "$buy"; return; }
	owner="$(jget '@.site.owner_id')"; site="$(jget '@.site.id')"
	api="${buy%%/buy*}"
	mkdir -p "$WWWDIR"
	cp -f "$PORTAL_SRC"/* "$WWWDIR"/ 2>/dev/null
	[ -s /etc/lightnet/portal/logo.png ] || [ ! -s /www/luci-static/lightnet/logo.png ] || cp -f /www/luci-static/lightnet/logo.png "$WWWDIR"/logo.png
	# Router fetches packages now so the local page does not need client DNS.
	plans="[]"
	if [ -n "$api" ] && [ -n "$owner" ] && [ -n "$site" ]; then
		plans_json="$(curl -sL --max-time 20 -H 'Accept: application/json' "$api/api/buy/bootstrap?owner=$owner&site=$site" 2>/dev/null | jsonfilter -e '@.plans' 2>/dev/null)"
		[ -n "$plans_json" ] && plans="$plans_json"
	fi
	cat >"$WWWDIR/config.js" <<EOF
window.LIGHTNET={owner:"$(jsq "$owner")",site:"$(jsq "$site")",api:"$(jsq "$api")",ssid:"$(jsq "$(jget '@.site.ssid')")",phone:"$(jsq "$(jget '@.site.contact_phone')")",plans:$plans,uamip:"$HS_GW",uamport:"3990"};
EOF
	printf 'http://%s:3990/www/lightnet.html?v=4&owner=%s&site=%s' "$HS_GW" "$owner" "$site"
}

active_role() { sed -n 's/^active_role=//p' /etc/lightnet/state 2>/dev/null | tail -n1; }
br_lan_section() {
	i=0
	while :; do
		name="$(uci -q get "network.@device[$i].name")"
		[ -z "$name" ] && break
		[ "$name" = "br-lan" ] && { echo "$i"; return; }
		i=$((i + 1))
	done
}
# Satellite client ports (lan1+lan2) are part of the portal, exactly like the SSIDs. The wired
# backhaul (root: lan2 -> satellites, agent: wan -> master) is a BATMAN hardif and never
# a client port. On the root, lan1 is the wired MANAGEMENT port (br-mgmt): LuCI/SSH without a
# voucher, but no forwarding at all, so it is not an Internet bypass. Wi-Fi stays behind chilli.
client_ports() { [ "$(active_role)" = "agent" ] && echo "lan1 lan2"; }

# management-only network on the root's lan1. DHCP hands out a /32 route to 192.168.2.1 and
# NO default gateway (option 3 suppressed), so a PC on Wi-Fi keeps its Internet uplink.
mgmt_on() {
	uci -q batch <<EOF
set network.dev_mgmt=device
set network.dev_mgmt.type='bridge'
set network.dev_mgmt.name='br-mgmt'
delete network.dev_mgmt.ports
set network.mgmt=interface
set network.mgmt.device='br-mgmt'
set network.mgmt.proto='static'
set network.mgmt.ipaddr='$MGMT_GW'
set network.mgmt.netmask='255.255.255.0'
set dhcp.mgmt=dhcp
set dhcp.mgmt.interface='mgmt'
set dhcp.mgmt.start='100'
set dhcp.mgmt.limit='100'
set dhcp.mgmt.leasetime='12h'
set dhcp.mgmt.ra='disabled'
set dhcp.mgmt.dhcpv6='disabled'
delete dhcp.mgmt.dhcp_option
add_list dhcp.mgmt.dhcp_option='3'
add_list dhcp.mgmt.dhcp_option='121,192.168.2.1/32,$MGMT_GW'
add_list dhcp.mgmt.dhcp_option='6,$MGMT_GW'
EOF
	for p in $MGMT_PORTS; do uci add_list network.dev_mgmt.ports="$p"; done
	uci commit network; uci commit dhcp
}

mgmt_off() {
	uci -q delete network.mgmt; uci -q delete network.dev_mgmt; uci -q delete dhcp.mgmt
	uci commit network; uci commit dhcp
}

# pin the client ports to br-hotspot (and off br-lan); root: lan1 -> br-mgmt. Returns 1 when changed
pin_ports() {
	[ -n "$(uci -q get network.hotspot)" ] || return 0
	br="$(br_lan_section)"; changed=0
	hs_ports="$(uci -q get network.dev_hs.ports)"
	lan_ports="$(uci -q get "network.@device[$br].ports")"
	for p in $(client_ports); do
		printf '%s\n' $hs_ports | grep -qx "$p" || { uci add_list network.dev_hs.ports="$p"; changed=1; }
		[ -n "$br" ] && printf '%s\n' $lan_ports | grep -qx "$p" && { uci del_list "network.@device[$br].ports=$p"; changed=1; }
	done
	if [ "$(active_role)" != "agent" ]; then
		for p in $MGMT_PORTS; do
			printf '%s\n' $hs_ports | grep -qx "$p" && { uci del_list network.dev_hs.ports="$p"; changed=1; }
			[ -n "$br" ] && printf '%s\n' $lan_ports | grep -qx "$p" && { uci del_list "network.@device[$br].ports=$p"; changed=1; }
		done
		[ "$(uci -q get network.mgmt.ipaddr)" = "$MGMT_GW" ] && [ -n "$(uci -q get dhcp.mgmt)" ] && [ "$(uci -q get network.dev_mgmt.ports)" = "$MGMT_PORTS" ] || { mgmt_on; changed=1; }
	fi
	[ "$changed" = 1 ] || return 0
	uci commit network
	return 1
}

# give the client ports back to br-lan (hotspot removed)
unpin_ports() {
	mgmt_off
	br="$(br_lan_section)"; [ -n "$br" ] || return 0
	lan_ports="$(uci -q get "network.@device[$br].ports")"
	for p in lan1 lan2; do
		[ "$p" = "lan2" ] && [ "$(active_role)" != "agent" ] && continue
		printf '%s\n' $lan_ports | grep -qx "$p" || uci add_list "network.@device[$br].ports=$p"
	done
	uci commit network
}

net_on() {
	uci -q batch <<EOF
set network.dev_hs_vlan=device
set network.dev_hs_vlan.type='8021q'
set network.dev_hs_vlan.ifname='bat0'
set network.dev_hs_vlan.vid='$VLAN'
set network.dev_hs_vlan.name='bat0.$VLAN'
set network.dev_hs=device
set network.dev_hs.type='bridge'
set network.dev_hs.name='br-hotspot'
delete network.dev_hs.ports
add_list network.dev_hs.ports='bat0.$VLAN'
set network.hotspot=interface
set network.hotspot.device='br-hotspot'
set network.hotspot.proto='none'
set network.hotspot.auto='1'
set wireless.default_radio0.network='hotspot'
set wireless.default_radio1.network='hotspot'
EOF
	uci commit network; uci commit wireless
	pin_ports || true
}

net_off() {
	unpin_ports
	uci -q batch <<EOF
delete network.hotspot
delete network.dev_hs
delete network.dev_hs_vlan
set wireless.default_radio0.network='lan'
set wireless.default_radio1.network='lan'
EOF
	uci commit network; uci commit wireless
}

fw_on() {
	uci -q batch <<EOF
delete firewall.ln_hs_zone
set firewall.ln_hs_zone=zone
set firewall.ln_hs_zone.name='hotspot'
add_list firewall.ln_hs_zone.device='tun0'
set firewall.ln_hs_zone.input='REJECT'
set firewall.ln_hs_zone.output='ACCEPT'
set firewall.ln_hs_zone.forward='REJECT'
delete firewall.ln_hs_l2
set firewall.ln_hs_l2=zone
set firewall.ln_hs_l2.name='hotspot_l2'
add_list firewall.ln_hs_l2.device='br-hotspot'
set firewall.ln_hs_l2.input='DROP'
set firewall.ln_hs_l2.output='DROP'
set firewall.ln_hs_l2.forward='DROP'
delete firewall.ln_hs_l2_fwd
set firewall.ln_hs_l2_fwd=rule
set firewall.ln_hs_l2_fwd.name='LightNet hotspot L2 no-forward (chilli owns br-hotspot)'
set firewall.ln_hs_l2_fwd.src='hotspot_l2'
set firewall.ln_hs_l2_fwd.dest='*'
set firewall.ln_hs_l2_fwd.proto='all'
set firewall.ln_hs_l2_fwd.target='DROP'
delete firewall.ln_hs_fwd
set firewall.ln_hs_fwd=forwarding
set firewall.ln_hs_fwd.src='hotspot'
set firewall.ln_hs_fwd.dest='wan'
delete firewall.ln_hs_uam
set firewall.ln_hs_uam=rule
set firewall.ln_hs_uam.name='LightNet hotspot UAM'
set firewall.ln_hs_uam.src='hotspot'
set firewall.ln_hs_uam.proto='tcp'
set firewall.ln_hs_uam.dest_port='3990 3991'
set firewall.ln_hs_uam.target='ACCEPT'
delete firewall.ln_hs_icmp
set firewall.ln_hs_icmp=rule
set firewall.ln_hs_icmp.name='LightNet hotspot ping'
set firewall.ln_hs_icmp.src='hotspot'
set firewall.ln_hs_icmp.proto='icmp'
set firewall.ln_hs_icmp.target='ACCEPT'
delete firewall.ln_hs_dns
set firewall.ln_hs_dns=rule
set firewall.ln_hs_dns.name='LightNet hotspot DNS'
set firewall.ln_hs_dns.src='hotspot'
set firewall.ln_hs_dns.proto='tcp udp'
set firewall.ln_hs_dns.dest_port='53'
set firewall.ln_hs_dns.target='ACCEPT'
delete firewall.ln_hs_mgmt
set firewall.ln_hs_mgmt=rule
set firewall.ln_hs_mgmt.name='LightNet hotspot management (authenticated clients -> LuCI/SSH)'
set firewall.ln_hs_mgmt.src='hotspot'
set firewall.ln_hs_mgmt.proto='tcp'
set firewall.ln_hs_mgmt.dest_port='22 80 443'
set firewall.ln_hs_mgmt.target='ACCEPT'
delete firewall.ln_mgmt_zone
set firewall.ln_mgmt_zone=zone
set firewall.ln_mgmt_zone.name='mgmt'
add_list firewall.ln_mgmt_zone.network='mgmt'
set firewall.ln_mgmt_zone.input='REJECT'
set firewall.ln_mgmt_zone.output='ACCEPT'
set firewall.ln_mgmt_zone.forward='REJECT'
delete firewall.ln_mgmt_web
set firewall.ln_mgmt_web=rule
set firewall.ln_mgmt_web.name='LightNet wired management port (LuCI/SSH, no portal, no Internet)'
set firewall.ln_mgmt_web.src='mgmt'
set firewall.ln_mgmt_web.proto='tcp'
set firewall.ln_mgmt_web.dest_port='22 80 443'
set firewall.ln_mgmt_web.target='ACCEPT'
delete firewall.ln_mgmt_svc
set firewall.ln_mgmt_svc=rule
set firewall.ln_mgmt_svc.name='LightNet wired management port DHCP/DNS'
set firewall.ln_mgmt_svc.src='mgmt'
set firewall.ln_mgmt_svc.proto='udp'
set firewall.ln_mgmt_svc.dest_port='53 67 68'
set firewall.ln_mgmt_svc.target='ACCEPT'
delete firewall.ln_mgmt_icmp
set firewall.ln_mgmt_icmp=rule
set firewall.ln_mgmt_icmp.name='LightNet wired management port ping'
set firewall.ln_mgmt_icmp.src='mgmt'
set firewall.ln_mgmt_icmp.proto='icmp'
set firewall.ln_mgmt_icmp.target='ACCEPT'
EOF
	uci commit firewall
}

fw_off() {
	for s in ln_hs_zone ln_hs_l2 ln_hs_l2_fwd ln_hs_fwd ln_hs_uam ln_hs_icmp ln_hs_dns ln_hs_mgmt ln_mgmt_zone ln_mgmt_web ln_mgmt_svc ln_mgmt_icmp; do uci -q delete "firewall.$s"; done
	uci commit firewall
}

write_conf() {
	[ -s "$SERVER_JSON" ] || return 1
	secret="$(jget '@.radius.secret')"; nasip="$(jget '@.radius.nas_ip')"; rserver="$(jget '@.radius.server')"
	[ -n "$secret" ] && [ -n "$nasip" ] || return 1
	buy="$(portal_url)"
	ips="$(jget '@.portal.walled_ips[*]' | tr '\n' ',' | sed 's/,$//')"
	hosts=""
	for h in $(jget '@.portal.walled_hosts[*]' | grep -v '^\*'); do
		nslookup "$h" >/dev/null 2>&1 && hosts="$hosts,$h" || log "walled garden: cannot resolve $h, skipped"
	done
	hosts="${hosts#,}"
	domains="$(jget '@.portal.walled_hosts[*]' | sed -n 's/^\*//p')"
	hsmac="$(cat /sys/class/net/br-hotspot/address 2>/dev/null | tr 'a-f:' 'A-F-')"
	nasid="$(jget '@.radius.nas_id')"; [ -n "$nasid" ] || nasid=LIGHTNET
	{
		printf 'cmdsocket %s\nunixipc /var/run/lightnet-chilli.ipc\npidfile %s\n' "$SOCK" "$PID"
		printf 'tundev tun0\nnet %s\nuamlisten %s\nuamport 3990\nuamuiport 3991\n' "$HS_NET" "$HS_GW"
		printf 'dhcpif br-hotspot\ndhcpstart 10\ndhcpend 254\nlease 3600\n'
		printf 'dns1 8.8.8.8\ndns2 1.1.1.1\nuamanydns\n'
		printf 'uamallowed "%s%s%s"\n' "$ips" "${hosts:+,}" "$hosts"
		# no uamdomain: chilli's DNS inspection drops modern DNS replies ("malformed DNS"); wildcard hosts are expanded instead
		for d in $domains; do for sub in "" www. lightnet. pay. api.; do nslookup "$sub${d#.}" >/dev/null 2>&1 && printf 'uamallowed %s\n' "$sub${d#.}"; done; done
		printf 'uamserver "%s"\nwwwdir %s\nnochallenge\nnouamsuccess\n' "$buy" "$WWWDIR"
		printf 'radiusserver1 %s\nradiusserver2 %s\nradiussecret "%s"\n' "$rserver" "$rserver" "$secret"
		printf 'radiusauthport %s\nradiusacctport %s\n' "$(jget '@.radius.auth_port')" "$(jget '@.radius.acct_port')"
		printf 'radiusnasid "%s"\nnasip %s\n' "$nasid" "$nasip"
		[ -n "$hsmac" ] && printf 'nasmac "%s:%s"\n' "$hsmac" "$nasid"
		printf 'radiuslocationname "%s"\n' "$(jget '@.site.name' | tr -d '"')"
		printf 'coaport %s\ncoanoipcheck\n' "$(jget '@.radius.coa_port')"
		printf 'macauth\nmacreauth\nacctupdate\ndefinteriminterval %s\n' "$(jget '@.radius.interim')"
		printf 'defidletimeout 0\n'
	} >"$CONF"
}

start() {
	[ "$(sed -n 's/^active_role=//p' /etc/lightnet/state 2>/dev/null | tail -n1)" = "root" ] || { log "not root; chilli not started"; return 0; }
	write_conf || { log "no provisioning data; chilli not started"; return 1; }
	stop
	ip link show br-hotspot >/dev/null 2>&1 || { log "br-hotspot missing"; return 1; }
	# 9>&- : never inherit lightnet-apply-role's lock fd, or chilli holds the role lock for life
	/usr/sbin/chilli --conf "$CONF" >/dev/null 2>&1 9>&- &
	sleep 2
	[ -s "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null && { log "chilli started (NAS $(jget '@.radius.nas_ip'))"; dns_guard; return 0; }
	log "chilli failed to start"; return 1
}

running() { [ -s "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; }

# Client DNS is hijacked by fw4 (dhcp.@dnsmasq[0].dns_redirect) to the local dnsmasq on the
# tun0 address. dnsmasq (bind-dynamic) sometimes misses tun0 appearing after it started, then
# the kernel answers every client query with "udp port 53 unreachable" => no DNS, no portal.
dns_guard() {
	running || return 0
	uamip="$(sed -n 's/^uamlisten //p' "$CONF" 2>/dev/null)"
	[ -n "$uamip" ] && ip -4 addr show tun0 2>/dev/null | grep -q "inet $uamip/" || return 0
	netstat -lnu 2>/dev/null | grep -q "^udp .*[ :]$uamip:53 " && return 0
	log "dnsmasq not listening on $uamip:53; restarting dnsmasq"
	/etc/init.d/dnsmasq restart >/dev/null 2>&1
}

# Client SSIDs must sit on the chilli VLAN while provisioned; anything else is a billing bypass
# (sysupgrade/uci-defaults or a role re-apply can put them back on br-lan).
wifi_guard() {
	[ -s "$SERVER_JSON" ] || return 0
	fixed=0
	ssid="$(uci -q get lightnet.wifi.ssid || echo LIGHTNET)"
	for i in default_radio0 default_radio1; do
		[ "$(uci -q get wireless.$i.network)" = "hotspot" ] || { uci set wireless.$i.network='hotspot'; fixed=1; }
		# a provisioned root always radiates the fleet SSID (uci-defaults leaves it disabled/default)
		[ "$(uci -q get wireless.$i.ssid)" = "$ssid" ] || { uci set wireless.$i.ssid="$ssid"; fixed=1; }
		[ "$(uci -q get wireless.$i.disabled)" = "0" ] || { uci set wireless.$i.disabled='0'; fixed=1; }
	done
	[ -n "$(uci -q get network.hotspot)" ] || { net_on; fixed=1; }
	pin_ports || fixed=1
	# the kernel also sees client frames on br-hotspot; without this rule fw4's
	# forward-chain REJECT answers each SYN with a TCP RST before chilli's redirect
	[ -n "$(uci -q get firewall.ln_hs_l2_fwd)" ] && [ -n "$(uci -q get firewall.ln_hs_mgmt)" ] && [ -n "$(uci -q get firewall.ln_mgmt_zone)" ] || { fw_on; fixed=1; /etc/init.d/firewall reload >/dev/null 2>&1; }
	# config may be right while the APs never came up (radios started before the profile was restored)
	if [ "$fixed" != 1 ]; then
		[ -d /sys/class/net/phy0-ap0 ] || [ -d /sys/class/net/phy1-ap0 ] && return 0
		log "client APs missing; reloading wifi"; wifi reload >/dev/null 2>&1; return 1
	fi
	uci commit wireless; uci commit network
	log "hotspot VLAN/firewall guard re-applied"
	ubus call network reload >/dev/null 2>&1; wifi reload >/dev/null 2>&1
	/etc/init.d/dnsmasq reload >/dev/null 2>&1; /etc/init.d/firewall reload >/dev/null 2>&1
	return 1
}

# start only if not already running (boot path may be triggered by several callers)
ensure() { wifi_guard || sleep 5; running && { dns_guard; return 0; }; start; }

stop() {
	[ -s "$PID" ] && kill "$(cat "$PID")" 2>/dev/null
	killall chilli 2>/dev/null
	rm -f "$PID" "$SOCK"
	ip link del tun0 2>/dev/null
}

status() {
	running=false; sessions=0; authed=0
	if [ -s "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; then
		running=true
		list="$(chilli_query -s "$SOCK" list 2>/dev/null)"
		sessions=$(printf '%s\n' "$list" | grep -c .)
		authed=$(printf '%s\n' "$list" | awk '$5==1' | grep -c .)
	fi
	printf '{"running":%s,"sessions":%s,"authorized":%s,"gateway":"%s"}\n' "$running" "$sessions" "$authed" "$HS_GW"
}

case "$1" in
	net) [ "$2" = "on" ] && net_on || net_off ;;
	fw) [ "$2" = "on" ] && fw_on || fw_off ;;
	start) start ;;
	ensure) ensure ;;
	running) running ;;
	stop) stop ;;
	restart) start ;;
	status) status ;;
	authorize) chilli_query -s "$SOCK" authorize mac "$2" ;;
	*) echo "usage: $0 net on|off | fw on|off | start | ensure | running | stop | status | authorize MAC"; exit 1 ;;
esac
