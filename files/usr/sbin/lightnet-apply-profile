#!/bin/sh

PROFILE="$1"
[ -s "$PROFILE" ] || exit 1
[ -f /etc/config/wireless ] || touch /etc/config/wireless
jsonfilter -i "$PROFILE" -e '@.adopted' 2>/dev/null | grep -q 'true' || exit 0

hostname="$(jsonfilter -i "$PROFILE" -e '@.hostname' 2>/dev/null)"
ssid="$(jsonfilter -i "$PROFILE" -e '@.wifi.ssid' 2>/dev/null)"
mode="$(jsonfilter -i "$PROFILE" -e '@.wifi.mode' 2>/dev/null)"
key="$(jsonfilter -i "$PROFILE" -e '@.wifi.key' 2>/dev/null)"
version="$(jsonfilter -i "$PROFILE" -e '@.config_version' 2>/dev/null)"
portal_ready="$(jsonfilter -i "$PROFILE" -e '@.portal_ready' 2>/dev/null)"

[ -n "$hostname" ] && uci set system.@system[0].hostname="$hostname"
[ -n "$ssid" ] && uci set lightnet.wifi.ssid="$ssid"
[ -n "$mode" ] && uci set lightnet.wifi.ssid_mode="$mode"
[ -n "$key" ] && uci set lightnet.wifi.key="$key" || uci -q delete lightnet.wifi.key
[ -n "$version" ] && uci set lightnet.wifi.config_version="$version"

enc='none'
case "$mode" in
	psk2) enc='psk2' ;;
	psk3|sae) enc='sae' ;;
	*) enc='none'; uci -q delete lightnet.wifi.key ;;
esac

disabled=0
[ "$mode" = "portal" ] && [ "$portal_ready" != "true" ] && disabled=1
hotspot="$(jsonfilter -i "$PROFILE" -e '@.hotspot' 2>/dev/null)"
had_hs=0
[ -n "$(uci -q get network.hotspot)" ] && had_hs=1
if [ "$hotspot" = "true" ]; then
	/usr/sbin/lightnet-hotspot net on
	client_net=hotspot
else
	[ "$had_hs" = 1 ] && /usr/sbin/lightnet-hotspot net off
	client_net=lan
fi
channel24="$(jsonfilter -i "$PROFILE" -e '@.channel24' 2>/dev/null)"
case "$channel24" in 1|6|11) uci set wireless.radio0.channel="$channel24" ;; esac
for iface in default_radio0 default_radio1; do
	uci set "wireless.$iface.network=$client_net"
	uci set "wireless.$iface.mode=ap"
	[ -n "$ssid" ] && uci set "wireless.$iface.ssid=$ssid"
	uci set "wireless.$iface.encryption=$enc"
	uci set "wireless.$iface.disabled=$disabled"
	if [ -n "$key" ] && [ "$enc" != "none" ]; then
		uci set "wireless.$iface.key=$key"
	else
		uci -q delete "wireless.$iface.key"
	fi
done

uci set lightnet.main.adopted='1'
uci set dhcp.lan.ignore='1'
uci commit system
uci commit lightnet
uci commit wireless
uci commit dhcp

grep -q '^adopted=' /etc/lightnet/state 2>/dev/null && sed -i 's/^adopted=.*/adopted=1/' /etc/lightnet/state || echo adopted=1 >>/etc/lightnet/state

/etc/init.d/dnsmasq stop >/dev/null 2>&1 || true
/etc/init.d/firewall stop >/dev/null 2>&1 || true
# radio1 is shared by mesh0 and the 5 GHz AP. `wifi reload` / network reload
# tears mesh0 down; MT7915 often stays in MESH-GROUP-STARTED with zero peers
# until a factory reset. Only bounce 2.4 GHz (radio0).
if [ "$hotspot" = "true" ] && [ "$had_hs" = 0 ]; then
	/etc/init.d/network reload >/dev/null 2>&1 || true
	sleep 2
fi
wifi down radio0 >/dev/null 2>&1 || true
wifi up radio0 >/dev/null 2>&1 || true
ubus call hostapd.phy1-ap0 reload >/dev/null 2>&1 || true
logger -t lightnet "adopted profile applied"
exit 0
