#!/bin/sh
# LightNet cloud agent: zero-touch enrollment with lightnet-server.
# Runs on the main router only. Enrolls every 60 s until provisioned, then
# heartbeats every 5 min and executes queued commands.
#   lightnet-cloud loop | once | enroll | heartbeat | status

ENROLL_KEY=/etc/lightnet/enroll.key
DEVICE_TOKEN=/etc/lightnet/device.token
WG_KEY=/etc/lightnet/wg.key
WG_PUB=/etc/lightnet/wg.pub
FW_ID=/rom/etc/lightnet/firmware.id
[ -s "$FW_ID" ] || FW_ID=/etc/lightnet/firmware.id
SERVER_JSON=/etc/lightnet/server.json
STATE=/tmp/lightnet-cloud.state
log() { logger -t lightnet-cloud "$*"; }
jq() { jsonfilter -s "$1" -e "$2" 2>/dev/null; }
esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr -d '\r\n'; }

base_url() { uci -q get lightnet.cloud.url || echo https://lightnetwork.pro; }
enabled() { [ "$(uci -q get lightnet.cloud.enabled || echo 1)" = "1" ]; }
is_root() { [ "$(sed -n 's/^active_role=//p' /etc/lightnet/state 2>/dev/null | tail -n1)" = "root" ]; }
state_set() { grep -q "^$1=" "$STATE" 2>/dev/null && sed -i "s|^$1=.*|$1=$2|" "$STATE" || echo "$1=$2" >>"$STATE"; }

ensure_cfg() {
	uci -q get lightnet.cloud >/dev/null 2>&1 || { uci set lightnet.cloud=cloud; uci set lightnet.cloud.enabled='1'; uci set lightnet.cloud.url='https://lightnetwork.pro'; uci set lightnet.cloud.status='unenrolled'; uci commit lightnet; }
}

ensure_keys() {
	[ -s "$WG_KEY" ] || { wg genkey >"$WG_KEY" 2>/dev/null; chmod 600 "$WG_KEY"; }
	[ -s "$WG_PUB" ] || wg pubkey <"$WG_KEY" >"$WG_PUB" 2>/dev/null
	[ -s "$DEVICE_TOKEN" ] || { tr -d '-' </proc/sys/kernel/random/uuid >"$DEVICE_TOKEN"; chmod 600 "$DEVICE_TOKEN"; }
}

sign() { printf '%s' "$1" | openssl dgst -sha256 -hmac "$(cat "$ENROLL_KEY")" 2>/dev/null | awk '{print $NF}'; }

satellites_json() {
	first=1; printf '['
	for f in /etc/lightnet/inform/*.json; do
		[ -s "$f" ] || continue
		m="$(basename "$f" .json)"
		grep -qi "^$m$" /etc/lightnet/adopted.list 2>/dev/null || continue
		name="$(cat "/etc/lightnet/names/$m" 2>/dev/null)"
		host="$(jsonfilter -i "$f" -e '@.hostname' 2>/dev/null)"
		sig="$(jsonfilter -i "$f" -e '@.uplink_signal' 2>/dev/null)"
		seen="$(stat -c %Y "/tmp/lightnet-seen/$m" 2>/dev/null || echo 0)"
		[ $first = 1 ] || printf ','
		printf '{"mac":"%s","hostname":"%s","name":"%s","signal":%s,"online":%s}' "$m" "$(esc "$host")" "$(esc "$name")" "${sig:-null}" \
			"$([ $(( $(date +%s) - seen )) -lt 120 ] && echo true || echo false)"
		first=0
	done
	printf ']'
}

payload() {
	ensure_keys
	mac="$(/usr/sbin/lightnet-macs id 2>/dev/null | tr 'A-F' 'a-f')"
	tok="$(cat "$DEVICE_TOKEN")"; pub="$(cat "$WG_PUB")"
	build="$(sed -n 's/^build=//p' "$FW_ID" 2>/dev/null)"; ver="$(sed -n 's/^version=//p' "$FW_ID" 2>/dev/null)"
	ts="$(date +%s)"
	sig="$(sign "$mac|$tok|$pub|$build|$ts")"
	model="$(ubus call system board 2>/dev/null | jsonfilter -e '@.model' 2>/dev/null)"
	wanip="$(ubus call network.interface.wan status 2>/dev/null | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)"
	up="$(cut -d. -f1 /proc/uptime)"
	clients=0
	[ -S /var/run/lightnet-chilli.sock ] && clients="$(chilli_query -s /var/run/lightnet-chilli.sock list 2>/dev/null | awk '$5==1' | grep -c .)"
	printf '{"mac":"%s","device_token":"%s","wg_public_key":"%s","fw_build":"%s","fw_version":"%s","model":"%s","hostname":"%s","wan_ip":"%s","lan_gateway":"192.168.88.1","uptime":%s,"clients":%s,"satellites":%s,"ts":%s,"sig":"%s"}' \
		"$mac" "$tok" "$(esc "$pub")" "$(esc "$build")" "$(esc "$ver")" "$(esc "$model")" "$(cat /proc/sys/kernel/hostname)" "$wanip" "${up:-0}" "${clients:-0}" "$(satellites_json)" "$ts" "$sig"
}

post() { curl -s -m 40 -H 'Content-Type: application/json' -X POST --data-binary "$2" "$(base_url)$1" 2>/dev/null; }

run_commands() {
	resp="$1"; n=0
	while :; do
		type="$(jq "$resp" "@.commands[$n].type")"; [ -n "$type" ] || break
		log "command: $type"
		case "$type" in
			reboot) sleep 2; reboot ;;
			reprovision) rm -f "$SERVER_JSON"; uci set lightnet.cloud.status='pending'; uci commit lightnet; state_set next_enroll 0 ;;
			upgrade)
				url="$(jq "$resp" "@.commands[$n].url")"; sum="$(jq "$resp" "@.commands[$n].sha256")"
				[ -n "$url" ] && curl -s -L -m 600 -o /tmp/lightnet-upgrade.bin "$url" && {
					have="$(sha256sum /tmp/lightnet-upgrade.bin | awk '{print $1}')"
					if [ -z "$sum" ] || [ "$have" = "$sum" ]; then log "upgrading firmware"; sysupgrade -k /tmp/lightnet-upgrade.bin; else log "upgrade checksum mismatch"; rm -f /tmp/lightnet-upgrade.bin; fi
				} ;;
		esac
		n=$((n + 1))
	done
}

enroll() {
	resp="$(post /api/router/enroll "$(payload)")"
	[ -n "$resp" ] || { state_set last_error "no response"; return 1; }
	status="$(jq "$resp" '@.status')"; rid="$(jq "$resp" '@.router_id')"
	[ -n "$status" ] || { state_set last_error "$(jq "$resp" '@.error')"; log "enroll error: $(jq "$resp" '@.error')"; return 1; }
	uci set lightnet.cloud.status="$status"; [ -n "$rid" ] && uci set lightnet.cloud.router_id="$rid"; uci commit lightnet
	state_set last_ok "$(date +%s)"; state_set last_error ""
	case "$status" in
		provisioned)
			jq "$resp" '@.provision' >/tmp/lightnet-provision.json
			if ! cmp -s /tmp/lightnet-provision.json "$SERVER_JSON" 2>/dev/null; then
				/usr/sbin/lightnet-provision apply /tmp/lightnet-provision.json && log "provisioned as site $(jq "$resp" '@.provision.site.id')"
			fi ;;
		pending) log "registered (router #$rid); waiting for assignment" ;;
		*) log "server says: $status" ;;
	esac
	return 0
}

heartbeat() {
	resp="$(post /api/router/heartbeat "$(payload)")"
	[ -n "$resp" ] || { state_set last_error "no response"; return 1; }
	if [ "$(jq "$resp" '@.ok')" = "true" ]; then
		state_set last_ok "$(date +%s)"; state_set last_error ""
		run_commands "$resp"
		[ "$(jq "$resp" '@.reenroll')" = "true" ] && state_set next_enroll 0
		[ -s "$SERVER_JSON" ] && ! pgrep -x chilli >/dev/null 2>&1 && /usr/sbin/lightnet-hotspot start
		return 0
	fi
	[ "$(jq "$resp" '@.reenroll')" = "true" ] && { uci set lightnet.cloud.status='pending'; uci commit lightnet; }
	state_set last_error "$(jq "$resp" '@.error')"; return 1
}

status() {
	ensure_cfg
	st="$(uci -q get lightnet.cloud.status || echo unenrolled)"
	hs="$(sed -n 's/^last_ok=//p' "$STATE" 2>/dev/null)"; err="$(sed -n 's/^last_error=//p' "$STATE" 2>/dev/null)"
	wgup=false; hands=0
	if ip link show wgln >/dev/null 2>&1; then wgup=true; hands="$(wg show wgln latest-handshakes 2>/dev/null | awk '{print $2}' | head -n1)"; fi
	printf '{"enabled":%s,"url":"%s","status":"%s","router_id":"%s","site_id":"%s","site_name":"%s","wg_ip":"%s","wg_up":%s,"wg_handshake_age":%s,"last_ok":%s,"last_error":"%s","hotspot":%s}\n' \
		"$(enabled && echo true || echo false)" "$(base_url)" "$st" "$(uci -q get lightnet.cloud.router_id)" "$(uci -q get lightnet.cloud.site_id)" \
		"$(esc "$(uci -q get lightnet.cloud.site_name)")" "$(uci -q get lightnet.cloud.wg_ip)" "$wgup" \
		"$([ "${hands:-0}" -gt 0 ] && echo $(( $(date +%s) - hands )) || echo null)" "${hs:-null}" "$(esc "$err")" "$(/usr/sbin/lightnet-hotspot status 2>/dev/null || echo null)"
}

once() {
	ensure_cfg
	enabled || return 0
	is_root || return 0
	[ -s "$ENROLL_KEY" ] || { log "no enroll key"; return 1; }
	ubus call network.interface.wan status 2>/dev/null | grep -q '"up": true' || return 0
	if [ -s "$SERVER_JSON" ] && [ "$(uci -q get lightnet.cloud.status)" = "provisioned" ]; then heartbeat; else enroll; fi
}

loop() {
	sleep 40
	fails=0
	while :; do
		if once; then fails=0; else fails=$((fails + 1)); fi
		if [ -s "$SERVER_JSON" ] && [ "$(uci -q get lightnet.cloud.status)" = "provisioned" ]; then sleep 300
		elif [ $fails -gt 60 ]; then sleep 600
		else sleep 60; fi
	done
}

case "$1" in
	loop) loop ;;
	once) once ;;
	enroll) enroll ;;
	heartbeat) heartbeat ;;
	status) status ;;
	*) echo "usage: $0 loop|once|enroll|heartbeat|status"; exit 1 ;;
esac
