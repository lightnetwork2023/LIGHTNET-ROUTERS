#!/bin/sh

tokens="$(printf '%s\n%s' "${HTTP_AUTHORIZATION#Bearer }" "$(printf '%s' "$HTTP_COOKIE" | tr ';' '\n' | sed -n 's/^[[:space:]]*sysauth[^=]*=//p')" | tr -cd 'A-Za-z0-9_\n')"
for token in $tokens; do
	ubus call session get "{\"ubus_rpc_session\":\"$token\"}" 2>/dev/null | grep -qE '"username"[[:space:]]*:[[:space:]]*"(root|LIGHTNET)"' && exit 0
done
exit 1
