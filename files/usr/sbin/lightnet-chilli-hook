#!/bin/sh
# CoovaChilli conup/condown hook (via lightnet-chilli-conup / -condown). chilli exports
# FRAMED_IP_ADDRESS, CALLING_STATION_ID (AA-BB-..), TERMINATE_CAUSE and passes no arguments.
#  - keeps fw4's ln_authed set (hotspot IPs with a valid session) in step with chilli, so
#    authenticated Wi-Fi clients may open the management page;
#  - when a voucher runs out (Session-Timeout 5 / Admin-Reset 6 from the server) the client is
#    kicked off Wi-Fi once: it re-associates within seconds, runs its captive-portal probe, chilli
#    answers 302 and the phone shows the sign-in page by itself instead of silently having no data.
ip="$FRAMED_IP_ADDRESS"
case "$ip" in *.*.*.*) ;; *) exit 0 ;; esac
case "$1" in
	down)
		nft delete element inet fw4 ln_authed "{ $ip }" 2>/dev/null
		case "$TERMINATE_CAUSE" in 5|6) /usr/sbin/lightnet-kick queue "$CALLING_STATION_ID" ;; esac ;;
	*) nft add element inet fw4 ln_authed "{ $ip timeout 2d }" 2>/dev/null ;;
esac
exit 0
