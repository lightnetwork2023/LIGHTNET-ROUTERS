config settings 'main'
	option role 'auto'
	option network_mode 'router'
	option controller '192.168.2.1'
	option adopted '0'
	option detection 'none'
	option detect_wait '45'
	option inform_interval '15'
	option company 'LIGHTNETWORK SOLUTION'

config fleet 'wifi'
	option ssid 'LIGHTNET'
	option ssid_mode 'open'
	option encryption 'none'
	option key ''
	option radio0_enabled '1'
	option radio1_enabled '1'
	option config_version '1'

config cloud 'cloud'
	option enabled '1'
	option url 'https://lightnetwork.pro'
	option status 'unenrolled'
